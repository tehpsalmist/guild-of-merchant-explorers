{
  "name": "guild-of-merchant-explorers",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite",
    "start": "vite --port 1234",
    "build": "npm run check && vite build",
    "codegen": "npm run codegen:schema && graphql-codegen",
    "codegen:schema": "nhost schema dump --root-folder ${NHOST_BACKEND_ROOT:-../../get-a-room} --subdomain ${NHOST_SUBDOMAIN:-local} --role user --output graphql.schema.graphql",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "codegen:types": "graphql-codegen",
    "lint": "eslint src tests codegen.ts vite.config.mts",
    "check": "npm run typecheck && npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/tehpsalmist/guild-of-merchant-explorers.git"
  },
  "keywords": [
    "react",
    "tailwindcss",
    "template"
  ],
  "author": "Ben Steward <bstewardcodes@gmail.com> (https://tehpsalmist.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tehpsalmist/guild-of-merchant-explorers/issues"
  },
  "homepage": "https://github.com/tehpsalmist/guild-of-merchant-explorers#readme",
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/events": "^3.0.3",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.2.25",
    "@types/simple-peer": "^9.11.8",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "events": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-imagetools": "^12.0.1",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "dependencies": {
    "@8thday/react": "^0.9.8",
    "@apollo/client": "^3.11.8",
    "@floating-ui/react": "^0.26.12",
    "@floating-ui/react-dom": "^2.0.8",
    "@headlessui/react": "^2.1.10",
    "@heroicons/react": "^2.1.3",
    "@nhost/react": "^3.6.0",
    "@nhost/react-apollo": "^13.0.0",
    "clsx": "^2.1.0",
    "graphql": "^16.14.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.27.0",
    "simple-peer": "^9.11.1"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120
  }
}
